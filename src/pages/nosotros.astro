---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
import TeamSection from "../components/about/TeamSection.astro";
import AboutHero from "../components/about/AboutHero.astro";
import CommitmentSection from "../components/about/CommitmentSection.astro";
import SvgSection from "../components/about/SvgSection.astro";
import FloatingMenu from "../components/FloatingMenu.astro";
---

<Layout
  title="Nosotros - RGB Studio | Estudio de Arquitectura en Lima"
  description="Conoce a RGB Studio, nuestro equipo de arquitectos en Lima especializado en crear espacios únicos. Descubre nuestra filosofía de diseño y compromiso con la excelencia en arquitectura e interiorismo."
  keywords="equipo RGB Studio, arquitectos profesionales Lima, estudio arquitectura Lima, quienes somos RGB, diseñadores interiores Lima"
>
  <Header light />
  <FloatingMenu triggerId="about-section" />

  <main class="bg-background text-foreground">
    <AboutHero />
    <CommitmentSection />
    <SvgSection />
    <TeamSection />
  </main>

  <Footer />
</Layout>
