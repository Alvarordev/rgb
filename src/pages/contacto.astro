---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import MenuModal from "../components/modals/MenuModal.astro";
import AnimatedParagraph from "../components/AnimatedParagraph.astro";
import TextSwipe from "../components/TextSwipe.astro";
import Button from "../components/Button.astro";

const phoneNumber = "51934887139";
const message =
  "Hola, estoy interesado en realizar un proyecto de diseño con ustedes. Quisiera más información sobre cómo trabajan.";
const whatsappUrl = `https://wa.me/${phoneNumber}?text=${encodeURIComponent(message)}`;
---

<Layout title="Contacto | RGB Arquitectura">
  <Header light />
  <MenuModal />

  <main class="bg-background text-foreground">
    <section
      class="min-h-screen w-full flex flex-col justify-center px-3.5 md:px-7 pt-32 md:pt-20"
    >
      <div
        class="flex flex-col md:grid md:grid-cols-12 w-full items-end gap-y-10 md:gap-y-0"
      >
        <div class="col-span-7 w-full">
          <AnimatedParagraph
            as="h1"
            duration={1.4}
            class="text-5xl md:text-[6rem] 2xl:text-[7.5rem] font-bold uppercase tracking-tight leading-tight md:leading-[0.9]"
          >
            Hablemos de <br /> tu proyecto
          </AnimatedParagraph>
        </div>
        <div
          class="col-span-5 flex flex-col items-start md:items-end pb-4 w-full"
        >
          <p class="text-sm font-bold uppercase mb-2">(Contacto)</p>
          <a
            href="mailto:rgb.studio.arquitectura@gmail.com"
            class="text-lg md:text-2xl 2xl:text-3xl font-bold tracking-tighter"
          >
            <TextSwipe>
              <Fragment slot="text1">rgb.studio.arquitectura@gmail.com</Fragment
              >
            </TextSwipe>
          </a>
        </div>
      </div>

      <div
        class="flex flex-col md:grid md:grid-cols-12 w-full mt-12 md:mt-20 border-t border-foreground/20 pt-10 gap-y-10 md:gap-y-0 pb-20 md:pb-0"
      >
        <!-- <div class="col-span-3">
          <p class="text-sm font-bold uppercase mb-6">(Ubicación)</p>
          <AnimatedParagraph
            class="text-xl md:text-2xl font-medium tracking-tighter"
          >
            Lima, Perú <br />
            Calle Las Camelias 790, <br />
            San Isidro
          </AnimatedParagraph>
        </div> -->

        <!-- <div class="hidden md:block col-span-1"></div> -->

        <div class="col-span-3">
          <p class="text-sm font-bold uppercase mb-6">(Redes Sociales)</p>
          <ul class="flex flex-col gap-2">
            <li>
              <a
                href="https://www.instagram.com/rgb.studio.pe/"
                target="_blank"
                class="text-xl md:text-2xl font-bold tracking-tighter"
              >
                <TextSwipe>
                  <Fragment slot="text1">Instagram</Fragment>
                </TextSwipe>
              </a>
            </li>
            <li>
              <a
                href="https://www.tiktok.com/@rgbstudiope?is_from_webapp=1&sender_device=pc"
                target="_blank"
                class="text-xl md:text-2xl font-bold tracking-tighter"
              >
                <TextSwipe>
                  <Fragment slot="text1">TikTok</Fragment>
                </TextSwipe>
              </a>
            </li>
            <!-- <li>
              <a
                href="#"
                class="text-xl md:text-2xl font-bold tracking-tighter"
              >
                <TextSwipe>
                  <Fragment slot="text1">WhatsApp</Fragment>
                </TextSwipe>
              </a>
            </li> -->
          </ul>
        </div>

        <div class="hidden md:block col-span-1"></div>

        <div class="col-span-4 flex flex-col justify-between">
          <div>
            <p class="text-sm font-bold uppercase mb-6">(Llámanos)</p>
            <a href="#" class="text-xl md:text-2xl font-bold tracking-tighter">
              <TextSwipe>
                <Fragment slot="text1">+51 934 887 139</Fragment>
              </TextSwipe>
            </a>
          </div>

          <div class="mt-10">
            <Button
              href={whatsappUrl}
              text1="INICIAR UNA CONSULTA"
              class="bg-foreground text-background border border-foreground w-fit px-8 h-14"
              textSwipeClass="font-bold tracking-tighter leading-[1.15] text-sm"
            />
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
