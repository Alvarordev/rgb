---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ProjectGalleryModal from "../../components/modals/ProjectGalleryModal.astro";
import ProjectHeader from "../../components/projects/ProjectHeader.astro";
import ProjectGallery from "../../components/projects/ProjectGallery.astro";
import { projects } from "../../data/projects";
import FloatingMenu from "../../components/FloatingMenu.astro";
import MenuModal from "../../components/modals/MenuModal.astro";

export async function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<Layout title={`${project.title} | RGB`}>
  <Header light={true} />
  <MenuModal />

  <main class="bg-background text-foreground pt-32 md:pt-40">
    <section class="px-3.5 md:px-7" aria-label="Detalles del proyecto">
      <ProjectHeader
        title={project.title}
        location={project.location}
        year={project.year}
        id={project.id}
      />

      <ProjectGallery
        images={project.images}
        videos={project.videos}
        projectTitle={project.title}
      />
    </section>

    <nav class="py-20 flex justify-center" aria-label="Navegación del proyecto">
      <a
        href="/proyectos"
        class="group flex items-center gap-4 text-sm font-bold uppercase tracking-tighter rounded-sm px-2 py-1"
      >
        <span
          class="w-10 h-px bg-foreground transition-all group-hover:w-16"
          aria-hidden="true"></span>
        Volver a Proyectos
      </a>
    </nav>

    <Footer />
  </main>

  <ProjectGalleryModal images={project.images} />
</Layout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const galleryTriggers = document.querySelectorAll<HTMLButtonElement>(
      "[data-gallery-trigger]"
    );

    galleryTriggers.forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const index = parseInt(trigger.dataset.index || "0", 10);
        if (typeof (window as any).openProjectGallery === "function") {
          (window as any).openProjectGallery(index);
        }
      });
    });
  });
</script>
