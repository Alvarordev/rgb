---
import Layout from "../../layouts/Layout.astro";
import FloatingMenu from "../../components/FloatingMenu.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import HorizontalScroll from "../../components/projects/HorizontalScroll.astro";
import ProjectsHero from "../../components/projects/ProjectsHero.astro";
---

<Layout
  title="Proyectos - RGB Studio | Arquitectura y Diseño de Interiores Lima"
  description="Explora nuestro portafolio de proyectos de arquitectura y diseño de interiores en Lima. Casas, departamentos y espacios residenciales que destacan por su diseño moderno y funcionalidad."
  keywords="proyectos arquitectura Lima, portafolio diseño interiores, remodelaciones Lima, casas modernas Lima, proyectos residenciales Perú"
>
  <Header light={true} />
  <FloatingMenu triggerId="horizontal-scroll-section" />

  <main class="bg-background text-foreground">
    <HorizontalScroll>
      <ProjectsHero />
    </HorizontalScroll>

    <Footer />
  </main>
</Layout>
