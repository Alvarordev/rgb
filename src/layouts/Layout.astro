---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import MenuModal from "../components/modals/MenuModal.astro";
import PageLoader from "../components/PageLoader.astro";

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
}

const { 
  title, 
  description = "Estudio de arquitectura en Lima, Perú especializado en diseño de interiores, remodelaciones y proyectos residenciales. Creamos espacios funcionales y estéticos que transforman tu hogar.",
  keywords = "arquitectura Lima, diseño de interiores Lima, arquitectos en Lima, remodelación de casas Lima, diseño arquitectónico Perú, interiorismo Lima, proyectos residenciales, arquitectura moderna Lima, decoración de interiores Perú, RGB Studio"
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <ClientRouter />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title ? title : "RGB Studio - Arquitectura y Diseño de Interiores en Lima, Perú"}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link
      rel="canonical"
      href={new URL(Astro.url.pathname, Astro.site || Astro.url)}
    />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="RGB Studio" />
    
    <!-- Geo Tags -->
    <meta name="geo.region" content="PE-LIM" />
    <meta name="geo.placename" content="Lima" />
    <meta name="geo.position" content="-12.046374;-77.042793" />
    <meta name="ICBM" content="-12.046374, -77.042793" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content="RGB Studio" />
    <meta property="og:title" content={title ? title : "RGB Studio - Arquitectura y Diseño de Interiores en Lima, Perú"} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={new URL("/og-logo.png", Astro.site || Astro.url).href} />
    <meta property="og:image:secure_url" content={new URL("/og-logo.png", Astro.site || Astro.url).href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="RGB Studio - Arquitectura y Diseño de Interiores Lima" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ? title : "RGB Studio - Arquitectura y Diseño de Interiores en Lima, Perú"} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/og-logo.png", Astro.site || Astro.url).href} />
    <meta name="twitter:site" content="@rgbstudiope" />
    <meta name="twitter:creator" content="@rgbstudiope" />
    
    <!-- JSON-LD Schema for Local Business -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ArchitecturalService",
        "name": "RGB Studio",
        "description": "Estudio de arquitectura especializado en diseño de interiores y proyectos residenciales en Lima, Perú",
        "url": "https://rgbstudio.pe",
        "logo": "https://rgbstudio.pe/og-logo.png",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Lima",
          "addressRegion": "Lima",
          "addressCountry": "PE"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": "-12.046374",
          "longitude": "-77.042793"
        },
        "areaServed": {
          "@type": "City",
          "name": "Lima"
        },
        "serviceType": ["Arquitectura", "Diseño de Interiores", "Remodelaciones", "Proyectos Residenciales"],
        "priceRange": "$$"
      }
    </script>
  </head>

  <body>
    <PageLoader />
    <MenuModal />
    <slot />

    <script>
      import Lenis from "lenis";
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);

      if (!(window as any).lenis) {
        const lenis = new Lenis({
          duration: 1.2,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          orientation: 'vertical',
          gestureOrientation: 'vertical',
          smoothWheel: true,
          wheelMultiplier: 1,
          touchMultiplier: 2,
        });
        (window as any).lenis = lenis;

        lenis.on("scroll", ScrollTrigger.update);

        gsap.ticker.add((time) => {
          lenis.raf(time * 1000);
        });

        gsap.ticker.lagSmoothing(0);
      }
    </script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
    background-color: var(--color-background);
  }
</style>
