---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title } = Astro.props;

const defaultTitle = "RGB Studio - Arquitectura y Diseño de Interiores";
const siteDescription = "Estudio de arquitectura en Lima especializado en diseño de interiores, remodelaciones y proyectos residenciales. En RGB Studio creamos espacios funcionales y estéticos.";
const siteTitle = title ? title : defaultTitle;
const ogImageURL = new URL("/og-logo.png", Astro.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription} />
    <link
      rel="canonical"
      href={Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url}
    />
    <meta name="robots" content="index, follow" />
    <meta http-equiv="Content-Language" content="es" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content="RGB Studio" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:secure_url" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:site" content="@rgbstudiope" />
    <meta name="twitter:creator" content="@rgbstudiope" />
  </head>

  <body>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
