---
import "../styles/global.css";
import MenuModal from "../components/modals/MenuModal.astro";

interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title ? title : "RGB Studio - Arquitectura y Diseño de Interiores"}</title>
    <meta name="description" content="Estudio de arquitectura en Lima especializado en diseño de interiores, remodelaciones y proyectos residenciales. En RGB Studio creamos espacios funcionales y estéticos." />
    <link
      rel="canonical"
      href={new URL(Astro.url.pathname, Astro.site || Astro.url)}
    />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content="RGB Studio" />
    <meta property="og:title" content={title ? title : "RGB Studio - Arquitectura y Diseño de Interiores"} />
    <meta property="og:description" content="Estudio de arquitectura en Lima especializado en diseño de interiores, remodelaciones y proyectos residenciales. En RGB Studio creamos espacios funcionales y estéticos." />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={new URL("/og-logo.png", Astro.site || Astro.url).href} />
    <meta property="og:image:secure_url" content={new URL("/og-logo.png", Astro.site || Astro.url).href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="RGB Studio Logo" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ? title : "RGB Studio - Arquitectura y Diseño de Interiores"} />
    <meta name="twitter:description" content="Estudio de arquitectura en Lima especializado en diseño de interiores, remodelaciones y proyectos residenciales. En RGB Studio creamos espacios funcionales y estéticos." />
    <meta name="twitter:image" content={new URL("/og-logo.png", Astro.site || Astro.url).href} />
    <meta name="twitter:site" content="@rgbstudiope" />
    <meta name="twitter:creator" content="@rgbstudiope" />
  </head>

  <body>
    <MenuModal />
    <slot />

    <script>
      import Lenis from "lenis";
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);

      const lenis = new Lenis();
      (window as any).lenis = lenis;

      lenis.on("scroll", ScrollTrigger.update);

      gsap.ticker.add((time) => {
        lenis.raf(time * 1000);
      });

      gsap.ticker.lagSmoothing(0);
    </script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    background-color: var(--color-background);
  }
</style>
