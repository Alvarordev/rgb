---
import TextSwipe from "./TextSwipe.astro";
import logo from "../assets/rgb-logo.png";
import { projects } from "../data/projects";
import Button from "./Button.astro";

const year = new Date().getFullYear();
---

<footer class="relative w-full bg-background flex flex-col pt-20 md:pt-40">
  <div class="flex flex-col mb-8 px-3.5 md:px-7">
    <p
      class="uppercase text-[3rem] md:text-[4.5rem] lg:text-[6.5rem] xl:text-[7.25rem] font-bold tracking-tight leading-[0.95] mb-8 text-wrap"
    >
      ¿Listo para comenzar
      <br class="md:hidden" />
      <span> tu nuevo proyecto? </span>
    </p>

    <div class="flex md:justify-center">
      <Button
        href="/contacto"
        text1="CUÉNTANOS SOBRE TU IDEA"
        class="bg-foreground text-background font-bold tracking-tighter leading-[0.85]"
      />
    </div>
  </div>

  <div
    class="flex flex-col md:grid md:grid-cols-12 w-full border-t border-foreground/20 pt-10 pb-5 px-3.5 md:px-7 gap-y-12 md:gap-y-0"
  >
    <div class="order-3 md:order-1 col-span-3 flex flex-col gap-4">
      <img
        src={projects[1].images[1].src}
        alt="casa-trujillo"
        class="w-full max-h-[60vh] object-cover"
      />
      <img src={logo.src} alt="rgb-logo" class="w-full" />
    </div>

    <div class="hidden md:block col-span-1 md:order-2"></div>

    <div class="order-1 md:order-3 md:col-span-3">
      <p class="font-bold text-sm mb-4">(NAVEGACIÓN)</p>
      <ul class="text-3xl xl:text-5xl font-bold flex flex-col gap-2 xl:gap-8">
        <li>
          <a href="/">
            <TextSwipe class="tracking-tighter leading-[0.85]">
              <Fragment slot="text1">Home</Fragment>
            </TextSwipe>
          </a>
        </li>
        <li>
          <a href="/proyectos">
            <TextSwipe
              class="tracking-tighter leading-[0.85]"
              class2="text-red-500"
            >
              <Fragment slot="text1">Proyectos</Fragment>
            </TextSwipe>
          </a>
        </li>
        <li>
          <a href="/nosotros">
            <TextSwipe
              class="tracking-tighter leading-[0.85]"
              class2="text-green-500"
            >
              <Fragment slot="text1">Nosotros</Fragment>
            </TextSwipe>
          </a>
        </li>
        <li>
          <a href="/contacto">
            <TextSwipe
              class="tracking-tighter leading-[0.85]"
              class2="text-blue-500"
            >
              <Fragment slot="text1">Contacto</Fragment>
            </TextSwipe>
          </a>
        </li>
      </ul>
    </div>

    <div class="hidden md:block md:col-span-1 md:order-4"></div>

    <div class="order-2 md:order-4 col-span-4">
      <div class="flex flex-col mb-12 md:mb-20">
        <p class="font-bold text-sm mb-2">(NUESTRA META)</p>
        <p class="text-xl md:text-2xl xl:text-3xl font-medium tracking-tighter text-balance">
          Transformamos espacios en experiencias únicas a través del diseño
          arquitectónico innovador.
        </p>
      </div>

      <div class="flex flex-col">
        <p class="font-bold text-sm mb-2">(SÍGUENOS)</p>
        <div class="mt-4">
          <ul class="flex gap-4 text-xl md:text-3xl font-bold tracking-tighter">
            <li>
              <a
                href="https://www.instagram.com/rgb.studio.pe/"
                target="_blank"
              >
                <TextSwipe class="tracking-tighter leading-[0.85]">
                  <Fragment slot="text1">Instagram</Fragment>
                </TextSwipe>
              </a>
            </li>
            <li>
              <a
                href="https://www.tiktok.com/@rgbstudiope?is_from_webapp=1&sender_device=pc"
                target="_blank"
              >
                <TextSwipe class="tracking-tighter leading-[0.85]">
                  <Fragment slot="text1">TikTok</Fragment>
                </TextSwipe>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="order-4 col-span-12">
      <p class="text-xs md:text-sm text-center mt-10 font-bold">
        © {year} RGB Studio. Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>
