---
import ImageCarousel from "../ImageCarousel.astro";
import AnimatedParagraph from "../AnimatedParagraph.astro";

interface Props {
  images: ImageMetadata[];
}

const { images } = Astro.props;
const year = new Date().getFullYear();
---

<section
  id="hero-section"
  class="bg-foreground text-background h-screen w-full flex flex-col overflow-hidden sticky top-0"
>
  <div class="h-full w-full flex flex-col">
    <div class="flex flex-1 justify-center items-center px-3.5 md:px-0">
      <AnimatedParagraph
        as="h1"
        class="leading-tight text-[2rem] md:text-[3.25rem] 2xl:text-[4.25rem] text-center md:max-w-5xl 2xl:max-w-6xl tracking-tighter font-semibold pt-20 title"
        duration={2}
      >
        Diseñamos espacios donde la arquitectura y el propósito se encuentran en
        cada detalle.
      </AnimatedParagraph>
    </div>

    <div class="flex flex-col justify-end items-end pb-2 carousel">
      <div
        class="flex w-full justify-between text-[10px] md:text-xs pb-2 px-3.5 md:px-7 font-bold"
      >
        <p class="flex-1 text-left">Lima, PE</p>
        <p class="text-center">RGB © {year}</p>
        <p class="flex-1 text-right">Arquitectura</p>
      </div>
      <ImageCarousel images={images} />
    </div>
  </div>
</section>
