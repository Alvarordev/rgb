---
import TextSwipe from "../TextSwipe.astro";
import Button from "../Button.astro";
import OptimizedImage from "../OptimizedImage.astro";
import { projects } from "../../data/projects";
---

<section
  class="relative flex flex-col w-full pt-20 pb-10 px-3.5 md:px-7 bg-background"
>
  <div class="flex justify-between items-end">
    <h3
      class="uppercase text-[2.5rem] sm:text-[2.75rem] md:text-[6.5rem] 2xl:text-[8rem] font-bold max-w-6xl leading-[0.95] tracking-normal"
    >
      Nuestros <br class="md:hidden" />
      <span class="md:ml-40">proyectos</span>
    </h3>

    <p class="text-4xl md:text-[8rem] font-bold leading-[0.95]">(05)</p>
  </div>

  <div class="grid grid-cols-12 gap-x-6 gap-y-10 md:gap-y-20 pt-12">
    <div class="col-span-12 md:col-span-6">
      <a href={`/proyectos/${projects[0].slug}`} class="flex flex-col group">
        <OptimizedImage
          src={projects[0].images[0]}
          alt={projects[0].title}
          class="max-h-[90vh] object-cover"
        />
        <div class="flex justify-between text-sm font-bold pt-2">
          <div class="flex">
            <p>(01)</p>
            <p class="pl-4 md:pl-8 uppercase">{projects[0].title}</p>
          </div>

          <div>
            <TextSwipe
              class="font-bold tracking-tighter leading-[0.85] text-sm text-end"
            >
              <Fragment slot="text1">{projects[0].year}</Fragment>
              <Fragment slot="text2">VER PROYECTO</Fragment>
            </TextSwipe>
          </div>
        </div>
      </a>
    </div>

    <div class="hidden md:block md:col-span-1"></div>

    <div class="col-span-12 md:col-span-5">
      <a href={`/proyectos/${projects[1].slug}`} class="flex flex-col group">
        <OptimizedImage
          src={projects[1].images[0]}
          alt={projects[1].title}
          imageClass="max-h-[60vh] object-cover object-center"
        />
        <div class="flex justify-between text-sm font-bold pt-2">
          <div class="flex">
            <p>(02)</p>
            <p class="pl-4 md:pl-8 uppercase">{projects[1].title}</p>
          </div>

          <div>
            <TextSwipe
              class="font-bold tracking-tighter leading-[0.85] text-sm text-end"
            >
              <Fragment slot="text1">{projects[1].year}</Fragment>
              <Fragment slot="text2">VER PROYECTO</Fragment>
            </TextSwipe>
          </div>
        </div>
      </a>
    </div>
    <div class="col-span-12 md:col-span-6">
      <div class="grid grid-cols-6">
        <a
          href={`/proyectos/${projects[2].slug}`}
          class="flex flex-col group col-span-6 md:col-span-5"
        >
          <OptimizedImage
            src={projects[2].images[0]}
            alt={projects[2].title}
            class="max-h-[80vh] object-cover"
          />

          <div class="flex justify-between text-sm font-bold pt-2">
            <div class="flex">
              <p>(03)</p>
              <p class="pl-4 md:pl-8 uppercase">{projects[2].title}</p>
            </div>

            <div>
              <TextSwipe
                class="font-bold tracking-tighter leading-[0.85] text-sm text-end"
              >
                <Fragment slot="text1">{projects[2].year}</Fragment>
                <Fragment slot="text2">VER PROYECTO</Fragment>
              </TextSwipe>
            </div>
          </div>
        </a>
      </div>
    </div>
    <div class="col-span-12 md:col-span-6">
      <a href={`/proyectos/${projects[3].slug}`} class="flex flex-col group">
        <OptimizedImage
          src={projects[3].images[0]}
          alt={projects[3].title}
          imageClass="max-h-[60vh] object-cover object-center"
        />

        <div class="flex justify-between text-sm font-bold pt-2">
          <div class="flex">
            <p>(04)</p>
            <p class="pl-4 md:pl-8 uppercase">{projects[3].title}</p>
          </div>

          <div>
            <TextSwipe
              class="font-bold tracking-tighter leading-[0.85] text-sm text-end"
            >
              <Fragment slot="text1">{projects[3].year}</Fragment>
              <Fragment slot="text2">VER PROYECTO</Fragment>
            </TextSwipe>
          </div>
        </div>
      </a>
    </div>
    <div class="col-span-12 md:col-span-6 md:col-start-4">
      <a href={`/proyectos/${projects[4].slug}`} class="flex flex-col group">
        <OptimizedImage
          src={projects[4].images[0]}
          alt={projects[4].title}
          class="max-h-[80vh] object-cover"
        />
        <div class="flex justify-between text-sm font-bold pt-2">
          <div class="flex">
            <p>(05)</p>
            <p class="pl-4 md:pl-8 uppercase">{projects[4].title}</p>
          </div>

          <div>
            <TextSwipe
              class="font-bold tracking-tighter leading-[0.85] text-sm text-end"
            >
              <Fragment slot="text1">{projects[4].year}</Fragment>
              <Fragment slot="text2">VER PROYECTO</Fragment>
            </TextSwipe>
          </div>
        </div>
      </a>
    </div>
  </div>

  <div class="flex items-center justify-center w-full mt-2 md:mt-10">
    <Button
      href="/proyectos"
      class="bg-foreground mt-6 md:mt-10"
      text1="Ver todos los proyectos"
      textSwipeClass="font-bold tracking-tighter leading-[1.15] text-sm text-[#fcfcfc]"
    />
  </div>
</section>
