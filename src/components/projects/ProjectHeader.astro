---
interface Props {
  title: string;
  location: string;
  year: string;
  id: number;
}

const { title, location, year, id } = Astro.props;
---

<div
  class="flex flex-col md:flex-row justify-between items-start md:items-end gap-8 mb-12 md:mb-24"
>
  <div>
    <h1
      class="text-4xl md:text-[6.5rem] 2xl:text-[8rem] font-bold uppercase leading-[0.85] tracking-tighter mb-4"
    >
      {title}
    </h1>
    <dl class="flex gap-8 text-sm md:text-base font-medium uppercase">
      <div class="flex flex-col">
        <dt class="text-foreground/60 text-xs mb-1">Ubicación</dt>
        <dd>{location}</dd>
      </div>
      <div class="flex flex-col">
        <dt class="text-foreground/60 text-xs mb-1">Año</dt>
        <dd>{year}</dd>
      </div>
    </dl>
  </div>

  <p
    class="text-4xl md:text-[8rem] font-bold leading-[0.95] text-foreground"
    aria-label={`Proyecto número ${id}`}
  >
    ({id.toString().padStart(2, "0")})
  </p>
</div>
