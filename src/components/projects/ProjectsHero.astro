---
import AnimatedParagraph from "../AnimatedParagraph.astro";
---

<div
  class="flex flex-col md:flex-row justify-between md:items-end w-full gap-y-8 md:gap-y-0"
>
  <AnimatedParagraph
    as="h1"
    duration={1.5}
    class="text-5xl md:text-[6.5rem] 2xl:text-[7.25rem] font-bold tracking-tight uppercase leading-[0.85]"
  >
    Nuestros <br /> Proyectos
  </AnimatedParagraph>
  <AnimatedParagraph class="text-lg md:text-lg font-medium max-w-md">
    Explora nuestra selección de trabajos más recientes, donde cada espacio
    cuenta una historia única de diseño, funcionalidad y estética atemporal.
  </AnimatedParagraph>
</div>
