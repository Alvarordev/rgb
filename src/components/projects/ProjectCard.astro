---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  title: string;
  year: string;
  slug: string;
  image: ImageMetadata;
}

const { title, year, slug, image } = Astro.props;
---

<a href={`/proyectos/${slug}`} class="shrink-0 group flex flex-col h-fit">
  <div
    class="mb-4 md:opacity-0 group-hover:opacity-100 transition-all duration-500 translate-y-2 group-hover:translate-y-0"
  >
    <p class="text-sm font-bold uppercase tracking-tighter">
      {title}
    </p>
    <p class="text-xs text-foreground/60 uppercase font-medium">
      {year}
    </p>
  </div>
  <Image
    src={image}
    alt={title}
    height={600}
    class="max-h-68 md:max-h-75 w-full min-w-64 object-cover transition-transform group-hover:scale-[1.02] duration-500"
  />
</a>
