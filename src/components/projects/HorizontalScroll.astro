---
import ProjectCard from "./ProjectCard.astro";
import { projects } from "../../data/projects";
---

<section id="horizontal-scroll-section" class="relative h-auto lg:h-[300vh]">
  <div
    class="relative lg:sticky lg:top-0 h-auto lg:h-screen w-full lg:overflow-hidden flex flex-col px-3.5 md:px-7 pt-30 md:pt-40 pb-8"
  >
    <slot />

    <div
      class="hidden lg:block mt-4 lg:mt-8 w-full h-0.5 bg-foreground/10 relative overflow-hidden"
    >
      <div
        id="scroll-progress-line"
        class="absolute top-0 left-0 w-full h-full bg-foreground origin-left scale-x-0"
      >
      </div>
    </div>

    <div class="mt-8 lg:mt-auto -mx-3.5 md:-mx-7">
      <div
        id="horizontal-strip"
        class="flex flex-col lg:flex-row gap-4 lg:gap-4 px-3.5 md:px-7 items-start lg:items-end will-change-transform"
      >
        {
          projects.map((project) => (
            <div class="w-full lg:w-auto lg:shrink-0">
              <ProjectCard
                title={project.title}
                year={project.year}
                slug={project.slug}
                image={project.images[3]}
              />
            </div>
          ))
        }
        <div class="hidden lg:block shrink-0 w-[10vw] h-1"></div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initHorizontalScroll = () => {
    const section = document.querySelector("#horizontal-scroll-section");
    const strip = document.querySelector("#horizontal-strip") as HTMLElement;
    const progressLine = document.querySelector("#scroll-progress-line");

    if (!section || !strip || !progressLine) return;

    gsap.matchMedia().add("(min-width: 1024px)", () => {
      const getScrollAmount = () => {
        return strip.scrollWidth - window.innerWidth;
      };

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: "top top",
          end: "bottom bottom",
          scrub: 1,
          invalidateOnRefresh: true,
        },
      });

      tl.to(strip, {
        x: () => -getScrollAmount(),
        ease: "none",
      }, 0);

      tl.to(progressLine, {
        scaleX: 1,
        ease: "none",
      }, 0);
    });
  };

  initHorizontalScroll();
  document.addEventListener("astro:after-swap", initHorizontalScroll);
</script>

