---
import TextSwipe from "./TextSwipe.astro";
import Button from "./Button.astro";
import logoWhite from "../assets/rgb-logo-white.png";
import logo from "../assets/rgb-logo.png";
import { whatsappUrl } from "../data/whatsapp";

interface Props {
  light?: boolean;
}

const { light = false } = Astro.props;
---

<header class="absolute top-0 z-50 w-full px-3.5 md:px-7">
  <nav
    class:list={[
      "flex w-full justify-between mt-4 md:mt-8 items-center",
      light ? "text-foreground" : "text-background",
    ]}
  >
    <a href="/" class="flex items-center gap-4">
      {
        light ? (
          <img src={logo.src} alt="rgb-logo" class="w-20 md:w-32" />
        ) : (
          <img src={logoWhite.src} alt="rgb-logo" class="w-20 md:w-32" />
        )
      }
    </a>

    <ul class="hidden md:flex text-sm gap-4 font-bold items-center uppercase">
      <li>
        <a href="/proyectos">
          <TextSwipe
            class="tracking-tight leading-[0.85]"
            class2="text-red-500"
          >
            <Fragment slot="text1">Proyectos</Fragment>
          </TextSwipe>
        </a>
      </li>
      <li>
        <a href="/nosotros">
          <TextSwipe
            class="tracking-tight leading-[0.85]"
            class2="text-green-500"
          >
            <Fragment slot="text1">Nosotros</Fragment>
          </TextSwipe>
        </a>
      </li>
      <li>
        <a href="/contacto">
          <TextSwipe
            class="tracking-tight leading-[0.85]"
            class2="text-blue-500"
          >
            <Fragment slot="text1">Contacto</Fragment>
          </TextSwipe>
        </a>
      </li>
    </ul>

    <div class="hidden md:block">
      <Button
        href={whatsappUrl}
        class:list={[
          light
            ? "bg-foreground text-background"
            : "bg-background text-foreground",
        ]}
        text1="CONTÁCTANOS"
        textSwipeClass="font-bold tracking-tighter leading-[1.15] text-sm"
      />
    </div>

    <button
      class="open-menu-btn md:hidden uppercase font-bold text-sm tracking-tighter py-4"
    >
      <TextSwipe>
        <Fragment slot="text1">Menú</Fragment>
      </TextSwipe>
    </button>
  </nav>
</header>
