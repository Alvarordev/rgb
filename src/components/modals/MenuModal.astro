---
import logoWhite from "../../assets/rgb-logo-white.png";
import TextSwipe from "../TextSwipe.astro";
---

<div
  id="menu-modal"
  class="fixed inset-0 z-200 pointer-events-none overflow-hidden"
>
  <svg
    class="modal-transition absolute inset-0 w-full h-full"
    viewBox="0 0 100 100"
    preserveAspectRatio="none"
  >
    <path class="modal-path" fill="#151515" d="M 0 0 V 0 Q 50 0 100 0 V 0 z"
    ></path>
  </svg>

  <div
    class="modal-content relative h-full w-full flex flex-col justify-center items-start pl-3.5 md:pl-9 opacity-0 invisible"
  >
    <a
      href="/"
      class="absolute top-8 md:top-14 left-3.5 md:left-9 flex items-center gap-4"
    >
      <img src={logoWhite.src} alt="rgb-logo" class="w-20 md:w-32" />
    </a>

    <button
      id="close-modal"
      class="absolute top-10 md:top-14 right-3.5 md:right-9 text-background cursor-pointer group p-4 -m-4"
    >
      <TextSwipe class="font-bold tracking-tighter leading-[0.85] text-sm">
        <Fragment slot="text1">CERRAR</Fragment>
      </TextSwipe>
    </button>

    <nav
      class="flex flex-col items-start gap-4 md:gap-2 text-background text-5xl md:text-8xl font-bold tracking-tighter"
    >
      <a href="/" class="modal-nav-link">
        <TextSwipe>
          <Fragment slot="text1">HOME</Fragment>
        </TextSwipe>
      </a>
      <a href="/proyectos" class="modal-nav-link">
        <TextSwipe class2="text-red-500">
          <Fragment slot="text1">PROYECTOS</Fragment>
        </TextSwipe>
      </a>
      <a href="/nosotros" class="modal-nav-link">
        <TextSwipe class2="text-green-500">
          <Fragment slot="text1">NOSOTROS</Fragment>
        </TextSwipe>
      </a>
      <a href="/contacto" class="modal-nav-link">
        <TextSwipe class2="text-blue-500">
          <Fragment slot="text1">CONTACTO</Fragment>
        </TextSwipe>
      </a>
    </nav>

    <div class="absolute bottom-8 md:bottom-14 left-3.5 md:left-9 flex flex-col gap-4 text-background text-xl md:text-2xl font-bold tracking-tighter">
      <a
        href="https://www.instagram.com/rgb.studio.pe/"
        target="_blank"
      >
        <TextSwipe class="leading-[0.85]">
          <Fragment slot="text1">INSTAGRAM</Fragment>
        </TextSwipe>
      </a>
      <a
        href="https://www.tiktok.com/@rgbstudiope?is_from_webapp=1&sender_device=pc"
        target="_blank"
      >
        <TextSwipe class="leading-[0.85]">
          <Fragment slot="text1">TIKTOK</Fragment>
        </TextSwipe>
      </a>
    </div>
  </div>
</div>

<script>
  import { gsap } from "gsap";

  const initMenuModal = () => {
    const modal = document.querySelector<HTMLElement>("#menu-modal");
    const path = document.querySelector(".modal-path");
    const content = document.querySelector(".modal-content");
    const closeBtn = document.querySelector("#close-modal");
    const menuBtns = document.querySelectorAll(".open-menu-btn");

    if (!modal || !path || !content || !closeBtn || menuBtns.length === 0)
      return;

    const tl = gsap.timeline({
      paused: true,
      onStart: () => {
        modal.style.pointerEvents = "auto";
      },
      onReverseComplete: () => {
        modal.style.pointerEvents = "none";
      },
    });

    const midPath = "M 0 0 V 50 Q 50 100 100 50 V 0 z";
    const endPath = "M 0 0 V 100 Q 50 100 100 100 V 0 z";

    tl.to(path, {
      attr: { d: midPath },
      duration: 0.35,
      ease: "power2.in",
    })
      .to(path, {
        attr: { d: endPath },
        duration: 0.35,
        ease: "power2.out",
      })
      .to(
        content,
        {
          autoAlpha: 1,
          duration: 0.35,
          ease: "power3.out",
        },
        "-=0.2"
      );

    menuBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        tl.timeScale(1).play();
        document.body.style.overflow = "hidden";
        if ((window as any).lenis) (window as any).lenis.stop();
      });
    });

    closeBtn.addEventListener("click", () => {
      tl.timeScale(1.5).reverse();
      document.body.style.overflow = "";
      if ((window as any).lenis) (window as any).lenis.start();
    });

    const links = content.querySelectorAll("a");
    links.forEach((link) => {
      link.addEventListener("click", () => {
        tl.timeScale(1.5).reverse();
        document.body.style.overflow = "";
        if ((window as any).lenis) (window as any).lenis.start();
      });
    });
  };

  initMenuModal();
  document.addEventListener("astro:after-swap", initMenuModal);
</script>

<style>
  .modal-transition {
    pointer-events: none;
  }
</style>
